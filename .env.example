# Hindsight connection. Use Cloud (recommended for judging) or local Docker.
# Cloud: sign up at https://ui.hindsight.vectorize.io, add promo MEMHACK99 in billing for $50 credits
HINDSIGHT_BASE_URL=http://localhost:8888
# For Cloud use: HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=ap-vendor-memory

# Local fallback store (used automatically if Hindsight server is unreachable,
# so the demo never breaks on stage). Real Hindsight is always tried first.
MEMORY_FALLBACK_PATH=./data/memory_fallback.jsonl

# Optional: Groq for resolution suggestions (any LLM works). Agent works without it.
# Get free key at https://groq.com/
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
